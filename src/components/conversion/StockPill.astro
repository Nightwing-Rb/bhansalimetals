---
interface Props {
  location?: 'both' | 'opera-house' | 'kalamboli';
  grade?: string;
  text?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const {
  location = 'both',
  grade,
  text,
  size = 'md',
  class: className = '',
} = Astro.props;

let defaultText = 'Ready Stock — Opera House Godown / Kalamboli Yard';
if (location === 'opera-house') {
  defaultText = 'Ready Stock — Opera House Godown, Mumbai';
} else if (location === 'kalamboli') {
  defaultText = 'Ready Stock — Kalamboli Stockyard & Logistics Center';
}

if (grade && !text) {
  defaultText = `${grade} Ready Stock — Opera House Godown / Kalamboli Yard`;
}

const displayText = text || defaultText;
---

<div
  class={`stock-pill stock-pill-${size} ${className}`.trim()}
  role="status"
  aria-label={`Stock availability status: ${displayText}`}
>
  <span class="pulse-indicator" aria-hidden="true">
    <span class="pulse-ping"></span>
    <span class="pulse-core"></span>
  </span>
  <span class="stock-pill-text">{displayText}</span>
</div>

<style>
  .stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-success-soft);
    color: var(--color-success-deep);
    border: 1px solid #a7f3d0;
    border-radius: var(--radius-pill, 9999px);
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold, 600);
    letter-spacing: 0.01em;
    width: fit-content;
    white-space: nowrap;
    user-select: none;
    box-shadow: 0 1px 2px rgba(var(--color-success-rgb), 0.08);
  }

  .stock-pill-md {
    padding: 5px 12px;
    font-size: 0.75rem; /* 12px */
    line-height: 1.33;
  }

  .stock-pill-sm {
    padding: 3px 8px;
    font-size: 0.6875rem; /* 11px */
    line-height: 1.25;
    gap: 6px;
  }

  .pulse-indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  .pulse-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
  }

  .pulse-ping {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--color-success);
    animation: stock-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    opacity: 0.75;
  }

  @keyframes stock-ping {
    0% {
      transform: scale(0.9);
      opacity: 0.8;
    }
    70%, 100% {
      transform: scale(2.5);
      opacity: 0;
    }
  }

  .stock-pill-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .stock-pill {
      white-space: normal;
    }
  }
</style>
