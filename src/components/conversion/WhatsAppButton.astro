      target="_blank"
      rel="noopener noreferrer"
      class={`btn btn-whatsapp ${className}`.trim()}
      id={id}
      aria-label={`Inquire on WhatsApp for ${grade || product || 'materials'}`}
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.15C10.57 20.15 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.05 20.15ZM16.57 14.33C16.32 14.2 15.1 13.6 14.88 13.51C14.65 13.43 14.49 13.39 14.32 13.64C14.16 13.88 13.69 14.44 13.55 14.6C13.41 14.77 13.27 14.79 13.02 14.66C12.78 14.54 11.99 14.28 11.06 13.45C10.33 12.8 9.84 12 9.7 11.75C9.56 11.51 9.68 11.37 9.8 11.25C9.92 11.14 10.06 10.96 10.18 10.82C10.3 10.68 10.35 10.57 10.43 10.41C10.51 10.25 10.47 10.1 10.41 9.98C10.35 9.86 9.86 8.65 9.65 8.16C9.46 7.68 9.26 7.74 9.11 7.73C8.97 7.72 8.8 7.72 8.64 7.72C8.47 7.72 8.21 7.78 7.98 8.03C7.75 8.28 7.12 8.87 7.12 10.08C7.12 11.29 8 12.46 8.12 12.62C8.25 12.78 9.86 15.26 12.33 16.33C12.92 16.58 13.37 16.73 13.73 16.85C14.32 17.03 14.86 17.01 15.28 16.94C15.76 16.87 16.75 16.34 16.96 15.77C17.16 15.19 17.16 14.7 17.1 14.6C17.03 14.49 16.82 14.45 16.57 14.33Z"/>
      </svg>
      <span>{defaultInlineLabel}</span>
    </a>
  )
}

<style>
  /* Floating Variant */
  .wa-floating-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99;
  }

  .wa-floating-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #25d366;
    color: #ffffff;
    padding: 8px 18px 8px 12px;
    border-radius: var(--radius-pill, 9999px);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35), 0 2px 6px rgba(26, 26, 26, 0.15);
    text-decoration: none;
    transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .wa-floating-btn:hover {
    background-color: #20ba59;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
  }

  .wa-floating-btn:active {
    transform: translateY(0);
  }

  .wa-icon-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .live-dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid #25d366;
    animation: live-pulse 2s infinite ease-in-out;
  }

  @keyframes live-pulse {
    0% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 6px rgba(255, 255, 255, 0);
    }
    100% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
  }

  .wa-floating-label {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .wa-title {
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold, 600);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.92;
  }

  .wa-phone {
    font-size: 0.8125rem;
    font-weight: var(--weight-bold, 700);
    font-family: var(--font-mono, monospace);
  }

  @media (max-width: 640px) {
    .wa-floating-wrapper {
      bottom: 20px;
      right: 16px;
    }
    .wa-floating-label {
      display: none;
    }
    .wa-floating-btn {
      padding: 10px;
      border-radius: 50%;
      width: 52px;
      height: 52px;
      justify-content: center;
    }
    .wa-icon-box {
      width: 32px;
      height: 32px;
    }
  }
</style>
