---
import { generateWhatsAppUrl, SALES_WHATSAPP_DISPLAY } from '../../utils/whatsapp';

interface Props {
  variant?: 'floating' | 'inline' | 'compact';
  grade?: string;
  product?: string;
  size?: string;
  quantity?: string;
  customMessage?: string;
  label?: string;
  showNumber?: boolean;
  class?: string;
  id?: string;
}

const {
  variant = 'inline',
  grade,
  product,
  size,
  quantity,
  customMessage,
  label,
  showNumber = true,
  class: className = '',
  id,
} = Astro.props;

const href = generateWhatsAppUrl({
  grade,
  product,
  size,
  quantity,
  customMessage,
});

const defaultInlineLabel = label
  ? label
  : showNumber
    ? `WhatsApp Sales (${SALES_WHATSAPP_DISPLAY})`
    : 'Chat on WhatsApp';
---

