          </svg>
          <span class="live-dot" aria-hidden="true"></span>
        </span>
        <span class="wa-floating-label">
          <span class="wa-title">Direct Sales Desk</span>
          <span class="wa-phone">{SALES_WHATSAPP_DISPLAY}</span>
        </span>
      </a>
    </aside>
  ) : variant === 'compact' ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class={`btn btn-whatsapp btn-sm ${className}`.trim()}
      id={id}
