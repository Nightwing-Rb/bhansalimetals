  variant === 'floating' ? (
    <aside class={`wa-floating-wrapper ${className}`.trim()} aria-label="WhatsApp Quick Support">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="wa-floating-btn"
        id={id || 'wa-floating-cta'}
        aria-label={`Chat with Bhansali Metals Sales Desk on WhatsApp at ${SALES_WHATSAPP_DISPLAY}`}
      >
        <span class="wa-icon-box">
