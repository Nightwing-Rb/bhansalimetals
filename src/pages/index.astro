---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import Badge from '../components/common/Badge.astro';
import TrustSection from '../components/trust/TrustSection.astro';
import { siteConfig } from '../data/site';

const productCategories = [
  {
    title: 'ASME B16.5 Flanges',
    specs: 'Class 150 to 2500# | 1/2" to 24" NB',
    desc: 'Weld Neck (WNRF), Slip-On (SORF), Blind (BLRF), Socket Weld, and Lap Joint flanges in High Nickel & Stainless Steel.',
    href: '/products/flanges',
    grade: 'Inconel 625 / Monel 400',
  },
  {
    title: 'Pipes & Heavy Wall Tubes',
    specs: 'Seamless & Welded | Sch 10 to XXS',
    desc: 'Corrosion resistant high-pressure piping for chemical, offshore, and nuclear applications with full MTC 3.1.',
    href: '/products/pipes-tubes',
    grade: 'Hastelloy C-276 / SS 316L',
  },
  {
    title: 'ASME B16.9 Buttweld Fittings',
    specs: '45°/90° Elbows, Equal & Reducing Tees',
    desc: 'Concentric & eccentric reducers, stub ends, and pipe caps manufactured to strict dimensional tolerances.',
    href: '/products/buttweld-fittings',
    grade: 'Incoloy 800H / Duplex 2205',
  },
  {
    title: 'High-Pressure Forged Fittings',
    specs: 'Class 3000#, 6000#, 9000# | ASME B16.11',
    desc: 'Threaded and socket-weld elbows, couplings, unions, hex nipples, and plugs for severe sour service.',
    href: '/products/forged-fittings',
    grade: 'Monel K-500 / Nickel 200',
  },
  {
    title: 'Industrial Heavy Fasteners',
    specs: 'Heavy Hex Bolts, Studs, Nuts, Washers',
    desc: 'Precision high-tensile studs and nuts meeting ASTM A193/A194 and NACE MR0175 sour gas specifications.',
    href: '/products/fasteners',
    grade: 'Inconel 718 / SS 310S',
  },
  {
    title: 'Round Bars & Precision Billets',
    specs: 'Dia 6mm to 450mm | Bright & Black',
    desc: 'Centerless ground, peeled, and hot rolled rounds with ultrasonic test certification for critical rotating shafts.',
    href: '/products/round-bars',
    grade: 'Hastelloy C-22 / SS 904L',
  },
  {
    title: 'Sheets, Plates & Coils',
    specs: 'Thickness 0.5mm to 100mm | Cut-to-Size',
    desc: 'Hot rolled and cold rolled alloy plates with waterjet cutting, shearing, and plasma profile cutting services.',
    href: '/products/sheets-plates',
    grade: 'Super Duplex 2507',
  },
  {
    title: 'High Nickel Superalloys Hub',
    specs: 'Inconel, Monel, Hastelloy, Nickel 200/201',
    desc: 'Direct stockist of premier European and US melt high nickel grades for extreme temperature and acid environments.',
    href: '/alloys',
    grade: 'UNS N06625 / W.Nr. 2.4856',
  },
];

const testingProtocols = [
  {
    title: '100% Spectro PMI Verification',
    desc: 'Positive Material Identification using calibrated handheld XRF analyzers on every single piece before dispatch.',
    icon: '/images/icons/spectro-pmi.svg',
  },
  {
    title: 'Hydrostatic Pressure Testing',
    desc: 'Full hydrostatic proof testing up to 15,000 PSI verifying integrity of welded and seamless pressure vessels.',
    icon: '/images/icons/hydrostatic.svg',
  },
  {
    title: 'Ultrasonic & Radiography (NDT)',
    desc: '100% volumetric examination detecting subsurface flaws, inclusions, and discontinuities to ASME Sec V.',
    icon: '/images/icons/ndt.svg',
  },
  {
    title: 'Intergranular Corrosion (IGC)',
    desc: 'ASTM A262 Practice E and ASTM G28 acid corrosion testing guaranteeing sour service endurance.',
    icon: '/images/icons/igc.svg',
  },
  {
    title: 'Cryogenic & Elevated Impact',
    desc: 'Charpy V-Notch impact testing at -196°C for subsea/LNG and elevated tensile tests up to 800°C.',
    icon: '/images/icons/impact.svg',
  },
  {
    title: 'EN 10204 3.1 & 3.2 Certification',
    desc: 'Comprehensive MTC documenting complete ladle chemical analysis, mechanical parameters, and heat treatment.',
    icon: '/images/icons/mtc.svg',
  },
];
---

<BaseLayout
  title="Bhansali Metals | High Nickel Alloys, Flanges, Pipes & Fittings Stockist Mumbai"
  description="Premier stockist & exporter of High Nickel Alloys (Inconel 625/600/718, Monel 400, Hastelloy C-276) and Stainless Steel Pipes, ASME B16.5 Flanges, and Fittings in Mumbai, India."
>
  <!-- ========================================================================
       APPLE-STYLE HERO SECTION (DARK GRADIENT + GLASSMORPHISM)
       ======================================================================== -->
  <section class="hero-section band-dark-gradient" aria-label="Company Overview and Core Capabilities">
    <div class="hero-bg-media" aria-hidden="true">
      <img
        src="/images/hero-bg.jpg"
        alt=""
        class="hero-bg-img"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-stats" data-animate style="transition-delay: 0.1s">
          <Badge variant="glass-dark">38+ Years Service</Badge>
          <Badge variant="glass-dark">1,800+ Tons Inventory</Badge>
          <Badge variant="glass-dark">45+ Export Ports</Badge>
        </div>

        <h1 class="display-xxl hero-headline" style="color: #ffffff; transition-delay: 0.2s;" data-animate>
          High Nickel Alloys &amp; <br/>Precision Piping Systems
        </h1>

        <p class="lead hero-lead" data-animate style="transition-delay: 0.3s">
          Direct stockist of Inconel, Monel, Hastelloy, Nickel, and Stainless Steel Flanges, Pipes, Fittings &amp; Fasteners. Engineered for severe corrosive, high-pressure, and cryogenic services.
        </p>

        <div class="hero-actions" data-animate style="transition-delay: 0.4s">
          <Button variant="primary" href="/rfq" size="md">
            <span>Request Instant RFQ</span>
          </Button>
          <Button variant="outline" href="/products" size="md" class="btn-outline-on-dark">
            <span>Explore Catalog</span>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       EDITORIAL PRODUCT SCROLL (ALTERNATING 1FR 1FR)
       ======================================================================== -->
  <section class="editorial-products band-canvas" aria-label="Featured Product Categories">
    <div class="container">
      <div class="section-heading-minimal" data-animate>
        <span class="eyebrow">Comprehensive Industrial Catalog</span>
        <h2 class="display-lg">Engineered Piping Lines</h2>
      </div>

      <div class="editorial-grid">
        {
          productCategories.slice(0, 4).map((product) => (
            <article class="editorial-row" data-animate>
              <div class="editorial-text">
                <Badge variant="glass" class="product-specs-pill">{product.specs}</Badge>
                <h3 class="display-lg product-title">{product.title}</h3>
                <p class="lead product-desc">{product.desc}</p>
                <div class="product-actions">
                  <a href={product.href} class="btn-text-link">
                    Explore {product.title.split(' ')[0]} &rarr;
                  </a>
                </div>
              </div>
              <div class="editorial-visual">
                <div class="glass-plate">
                  <span class="product-grade-watermark">{product.grade.split(' / ')[0]}</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="section-bottom-action centered" data-animate>
        <Button variant="outline" href="/products">
          <span>View All Products &rarr;</span>
        </Button>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       COMPACT TESTING PROTOCOLS (NUMBERED LIST)
       ======================================================================== -->
  <section class="band-cloud testing-section" aria-label="Quality Testing Protocols">
    <div class="container">
      <div class="section-heading-minimal" data-animate>
        <span class="eyebrow">Zero-Defect Quality Assurance</span>
        <h2 class="display-lg">Rigorous Testing Protocols</h2>
      </div>

      <div class="bento-grid">
        <!-- HERO TILE (2x2): the flagship protocol carries a real readout panel
             rather than more text — that is what makes this a bento and not a
             uniform card grid. -->
        <article class="bento-tile bento-tile-hero" data-animate>
          <div class="bento-head">
            <span class="bento-icon" aria-hidden="true">
              <img src={testingProtocols[0].icon} alt="" width="24" height="24" loading="lazy" />
            </span>
            <span class="bento-index">01</span>
          </div>
          <h3 class="bento-title bento-title-lead">{testingProtocols[0].title}</h3>
          <p class="bento-desc">{testingProtocols[0].desc}</p>

          <div class="xrf-readout">
            <div class="xrf-head">
              <span>XRF Spectrometer</span>
              <span class="xrf-live">
                <span class="xrf-dot" aria-hidden="true"></span>Live
              </span>
            </div>
            <dl class="xrf-rows">
              <div class="xrf-row">
                <dt>Heat No.</dt>
                <dd>625-4471-A</dd>
              </div>
              <div class="xrf-row">
                <dt>Ni</dt>
                <dd>61.2 %</dd>
              </div>
              <div class="xrf-row">
                <dt>Cr</dt>
                <dd>21.8 %</dd>
              </div>
              <div class="xrf-row">
                <dt>Mo</dt>
                <dd>8.9 %</dd>
              </div>
            </dl>
            <div class="xrf-verdict">
              <span>UNS N06625 confirmed</span>
              <span class="xrf-tick" aria-hidden="true">✓</span>
            </div>
          </div>
        </article>

        {
          testingProtocols.slice(1).map((protocol, idx) => (
            <article
              class:list={[
                'bento-tile',
                idx < testingProtocols.length - 2 ? 'bento-tile-sm' : 'bento-tile-wide',
              ]}
              data-animate
              style={`transition-delay: ${(idx + 1) * 0.08}s`}
            >
              <div class="bento-head">
                <span class="bento-icon" aria-hidden="true">
                  <img src={protocol.icon} alt="" width="24" height="24" loading="lazy" />
                </span>
                <span class="bento-index">0{idx + 2}</span>
              </div>
              <h3 class="bento-title">{protocol.title}</h3>
              <p class="bento-desc">{protocol.desc}</p>
            </article>
          ))
        }
      </div>

      <div class="card-glass quality-cta-box" data-animate>
        <div class="quality-cta-text">
          <h3 class="display-xs">Need Customized Inspection or 3.2 Third-Party Clearance?</h3>
          <p>We coordinate witness testing with your appointed agency (BV, TÜV, Lloyd's, EIL, DNV, SGS).</p>
        </div>
        <div class="quality-cta-btns">
          <Button variant="primary" href="/quality">
            <span>Our Quality Policy</span>
          </Button>
          <Button variant="outline" href="/certificates">
            <span>View Certificates</span>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       TRUST: certification credentials + accredited inspection agencies.
       One section, not two — the credential row and the agency marquee were
       previously separate bands carrying the same message under two headings.
       ======================================================================== -->
  <TrustSection class="band-canvas" />

  <!-- ========================================================================
       CLOSING SLAB
       ======================================================================== -->
  <section class="band-dark-gradient closing-slab" aria-label="Procurement Inquiry Desk">
    <div class="container closing-slab-container" data-animate>
      <div class="closing-slab-content">
        <span class="eyebrow eyebrow-light">Ready Stock • Rapid Dispatch</span>
        <h2 class="display-lg headline-light">
          Request an Official Technical Quotation (RFQ)
        </h2>
        <p class="lead lead-light">
          Send your Bill of Quantities (BOQ), material grades, size schedules, or purchase inquiries. Our certified metallurgical sales desk will respond within <strong>2 business hours</strong> with mill test certificate confirmation and ex-factory / CIF pricing.
        </p>

        <div class="closing-slab-actions">
          <Button variant="primary" href="/rfq" size="md">
            <span>Submit Bill of Quantities (BOQ)</span>
          </Button>
          <Button 
            variant="outline" 
            href={`https://wa.me/${siteConfig.contacts.salesWhatsAppRaw}?text=${encodeURIComponent('Hello Bhansali Metals Sales Desk, I would like to request an official quotation for high nickel alloys / flanges / fittings.')}`}
            target="_blank"
            rel="noopener noreferrer"
            size="md" 
            class="btn-outline-on-dark"
          >
            <span>Contact Mumbai Office</span>
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // IntersectionObserver for scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('[data-animate]').forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  /* Token values live in src/styles/tokens.css. This page deliberately does not
     re-declare them — a local :root override here previously pinned the homepage
     to the old HP-derived palette and silently diverged from the tokens. */

  /* Typography Defaults */
  .display-xxl {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .display-lg {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .lead {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  /* Glass Badges */
  .badge-glass-dark {
    background: var(--glass-bg-dark);
    backdrop-filter: blur(var(--glass-blur));
    border: var(--glass-border);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 4px 24px rgba(0,0,0,0.1);
  }

  .badge-glass-light {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid rgba(0, 0, 0, 0.05);
    color: var(--color-ink);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-block;
  }

  .card-glass {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
  }

  /* Shared Dark Styles */
  .band-dark-gradient {
    background: var(--surface-dark-gradient);
    position: relative;
    overflow: hidden;
  }
  
  .band-dark-gradient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--surface-mesh-subtle);
    pointer-events: none;
    z-index: 0;
  }

  .btn-outline-on-dark {
    border-color: rgba(255, 255, 255, 0.3) !important;
    color: #fff !important;
    background: transparent !important;
    border-radius: var(--radius-sm);
  }

  .btn-outline-on-dark:hover {
    border-color: #fff !important;
    background: rgba(255, 255, 255, 0.1) !important;
  }

  /* Hero Section */
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-bg-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.20;
    filter: brightness(0.65) contrast(1.15) saturate(1.1);
    transform: scale(1.02);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 75% 65% at 50% 48%, rgba(6, 13, 27, 0.85) 0%, rgba(6, 13, 27, 0.94) 65%, #060d1b 100%),
      linear-gradient(to bottom, rgba(6, 13, 27, 0.95) 0%, rgba(6, 13, 27, 0.5) 30%, rgba(6, 13, 27, 0.85) 75%, #060d1b 100%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1020px;
    margin: 0 auto;
  }

  .hero-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .hero-stats :global(.badge) {
    color: #ffffff !important;
    background: rgba(10, 22, 40, 0.85) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    font-weight: 500;
  }

  .hero-headline {
    margin: 0;
    color: #ffffff !important;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-shadow: 0 4px 28px rgba(0, 0, 0, 0.95), 0 2px 6px rgba(0, 0, 0, 0.9);
  }

  .hero-lead {
    color: #f1f5f9 !important;
    max-width: 780px;
    margin: 0 auto;
    font-size: 1.25rem;
    line-height: 1.65;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.95), 0 1px 4px rgba(0, 0, 0, 0.9);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Editorial Products */
  .editorial-products {
    padding: 7.5rem 0;
  }

  .section-heading-minimal {
    text-align: center;
    margin-bottom: 5rem;
  }

  .section-heading-minimal .eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
  }

  .editorial-grid {
    display: flex;
    flex-direction: column;
    gap: 7.5rem;
  }

  .editorial-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .editorial-row:nth-child(even) .editorial-text {
    order: 2;
  }

  .editorial-row:nth-child(even) .editorial-visual {
    order: 1;
  }

  .editorial-visual {
    height: 400px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.06) 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glass-plate {
    width: 80%;
    height: 80%;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: var(--glass-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  .product-grade-watermark {
    font-family: 'Inter', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: rgba(0,0,0,0.05);
    transform: rotate(-15deg);
  }

  .product-specs-pill {
    margin-bottom: 1.5rem;
  }

  .product-title {
    margin-bottom: 1.5rem;
    color: var(--color-ink);
  }

  .product-desc {
    color: var(--color-charcoal);
    margin-bottom: 2rem;
  }

  .btn-text-link {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 1.125rem;
    transition: opacity 0.2s var(--ease-apple);
  }

  .btn-text-link:hover {
    opacity: 0.8;
  }

  .section-bottom-action.centered {
    margin-top: 5rem;
    display: flex;
    justify-content: center;
  }

  /* Testing Section */
  .testing-section {
    padding: 7.5rem 0;
  }

  /* ---- Bento grid: testing protocols -------------------------------------
     Deliberately unequal spans. A 2x2 hero with one small tile beside it per
     row, then a wide tile closing the bottom row flush.

       +----------------+--------+--------+
       |                |  02    |  03    |
       |  01  hero 2x2  +--------+--------+
       |                |  04    |  05    |
       +----------------+--------+--------+
       |        06 wide (spans 3)         |
       +----------------------------------+

     Auto rows, not 1fr: the hero spans two rows and the small tiles fill those
     rows exactly, so nothing needs stretching. Forcing 1fr previously stretched
     the bottom tile to a two-row height and left a dead hole beside it. */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto;
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .bento-tile {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-soft);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 250ms var(--ease-apple), box-shadow 250ms var(--ease-apple),
                border-color 250ms var(--ease-apple);
  }

  .bento-tile:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary-soft);
    box-shadow: var(--shadow-elevated);
  }

  /* Hero: the only tile that carries a visual, and the only 2x2 span.
     It stretches to the height of the two rows beside it (2 small tiles +
     gap), which is ~100px more than its own content needs. Centring the
     content splits that slack evenly above and below instead of pooling it
     under the readout panel as a conspicuous empty block. */
  .bento-tile-hero {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
    padding: 2rem;
    gap: 0.75rem;
    justify-content: center;
  }

  /* Tiles 02-05 — the two pairs stacked beside the hero. */
  .bento-tile-sm {
    grid-column: span 1;
  }

  /* Tile 06 — a full-width closing tile. It spans the whole track rather than
     stopping at the hero's edge, otherwise the bottom-right of the grid is
     left with a conspicuous hole. */
  .bento-tile-wide {
    grid-column: 1 / -1;
  }

  .bento-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .bento-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sharp);
    background-color: var(--color-primary-soft);
    color: var(--color-primary-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bento-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-graphite);
  }

  .bento-title {
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: 1.3;
  }

  .bento-title-lead {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  .bento-desc {
    color: var(--color-charcoal);
    font-size: 0.9375rem;
    line-height: 1.6;
