---
import BaseHead from '../components/common/BaseHead.astro';
import UtilityStrip from '../components/layout/UtilityStrip.astro';
import Navbar from '../components/layout/Navbar.astro';
import MobileNav from '../components/layout/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import BottomBar from '../components/layout/BottomBar.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';
import '../styles/tables.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  schemaType?: 'Organization' | 'Product' | 'FAQPage';
  schemaData?: Record<string, any>;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  canonicalUrl,
  image,
  schemaType: _schemaType = 'Organization',
  schemaData,
} = Astro.props;

// Master Organization Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.bhansalimetals.com/#organization",
  "name": siteConfig.name,
  "legalName": siteConfig.legalName,
  "url": siteConfig.url,
  "logo": "https://www.bhansalimetals.com/images/logo.svg",
  "description": siteConfig.description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.office.address,
    "addressLocality": siteConfig.office.city,
    "addressRegion": siteConfig.office.state,
    "postalCode": siteConfig.office.pincode,
    "addressCountry": "IN"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.contacts.landline1,
      "contactType": "sales",
      "email": siteConfig.contacts.salesEmail,
      "availableLanguage": ["English", "Hindi", "Gujarati"]
    },
    {
      "@type": "ContactPoint",
      "telephone": siteConfig.contacts.salesWhatsApp,
      "contactType": "customer service",
      "contactOption": "WhatsApp",
      "availableLanguage": ["English", "Hindi"]
    }
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": siteConfig.certifications.iso,
      "credentialCategory": "Quality Certification",
      "recognizedBy": {
        "@type": "Organization",
        "name": siteConfig.certifications.isoBody,
        "identifier": siteConfig.certifications.isoRegNo
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      image={image}
    />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
    {
      schemaData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
      )
    }
  </head>
  <body>
    <!-- 1. Utility Strip: Contact & Yard Logistics (36px #1a1a1a) -->
    <UtilityStrip />

    <!-- 2. Main Navigation (64px #ffffff with hairline border) -->
    <Navbar />

    <!-- 3. Mobile Navigation Sheet -->
    <MobileNav />

    <!-- 4. Main Page Content Slot -->
    <main id="main-content">
      <slot />
    </main>

    <!-- 5. 5-Column Closing Dark Slab Footer (#1a1a1a) -->
    <Footer />

    <!-- 6. Bottom Regulatory Compliance Strip -->
    <BottomBar />

    <!-- Global Native HTML5 RFQ Modal Dialog (Zero runtime bloat) -->
    <dialog id="rfq-dialog-modal" class="rfq-modal" aria-labelledby="rfq-modal-title">
      <div class="rfq-dialog-container">
        <!-- Header -->
        <div class="rfq-header">
          <div>
            <span class="eyebrow" style="color: var(--color-primary-bright); margin-bottom: 2px;">Direct Procurement Desk</span>
            <h2 id="rfq-modal-title" class="rfq-modal-heading">Request Official Quotation (RFQ)</h2>
            <p class="rfq-modal-sub">EN 10204 3.1 MTC Guaranteed | Direct Kalamboli Yard Dispatch</p>
          </div>
          <button type="button" id="rfq-dialog-close" class="rfq-close-btn" aria-label="Close RFQ dialog">
            &times;
          </button>
        </div>

        <!-- Form -->
        <form id="rfq-dialog-form" class="rfq-form">
          <div class="form-row">
            <div class="form-group">
              <label for="rfq-alloy" class="form-label">Material / Alloy Grade *</label>
              <input type="text" id="rfq-alloy" name="alloy" required class="text-input" placeholder="e.g. Inconel 625 / Monel 400 / SS 316L" />
            </div>
            <div class="form-group">
              <label for="rfq-product" class="form-label">Product Form &amp; Rating *</label>
              <input type="text" id="rfq-product" name="product" required class="text-input" placeholder="e.g. WNRF Flanges 4&quot; 300# / Seamless Pipe" />
            </div>
          </div>

          <div class="form-group">
            <label for="rfq-boq" class="form-label">Bill of Quantities (BOQ) / Specifications</label>
            <textarea id="rfq-boq" name="boq" rows="3" class="text-input" placeholder="Enter sizes, schedules, quantities, or paste line items..."></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="rfq-name" class="form-label">Your Name *</label>
              <input type="text" id="rfq-name" name="name" required class="text-input" placeholder="e.g. Rajesh Sharma" />
            </div>
            <div class="form-group">
              <label for="rfq-company" class="form-label">Company Name *</label>
              <input type="text" id="rfq-company" name="company" required class="text-input" placeholder="e.g. Petrochemical EPC Ltd" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="rfq-email" class="form-label">Corporate Email *</label>
              <input type="email" id="rfq-email" name="email" required class="text-input" placeholder="e.g. procurement@company.com" />
            </div>
            <div class="form-group">
              <label for="rfq-phone" class="form-label">Phone / WhatsApp *</label>
              <input type="tel" id="rfq-phone" name="phone" required class="text-input" placeholder="e.g. +91 98200 12345" />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Submit RFQ to Sales Desk</button>
            <button type="button" id="rfq-wa-direct" class="btn btn-whatsapp">Send via WhatsApp</button>
          </div>
          <p class="rfq-notice">Response within 2 business hours. Mill Test Certificate (MTC 3.1) guaranteed on all supplies.</p>
        </form>
      </div>
    </dialog>

    <style>
      /* ── RFQ Modal — Glassmorphism Style ── */
      .rfq-modal {
        margin: auto;
        border: var(--glass-border-subtle);
        border-radius: var(--radius-soft);
        padding: 0;
        max-width: 620px;
        width: 92vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: var(--shadow-floating-modal);
        background-color: var(--color-canvas);
      }

      .rfq-modal::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .rfq-header {
        background: var(--surface-dark-gradient);
        color: #ffffff;
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
      }

      .rfq-modal-heading {
        font-size: 1.25rem;
        font-weight: var(--weight-display);
        color: #ffffff;
        margin: 0;
      }

      .rfq-modal-sub {
        font-size: 0.8125rem;
        color: var(--color-graphite);
        margin-top: 4px;
        color: rgba(255, 255, 255, 0.6);
      }

      .rfq-close-btn {
        min-width: 44px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: rgba(255, 255, 255, 0.6);
        font-size: 1.5rem;
        cursor: pointer;
        border-radius: var(--radius-sharp);
        transition: all 200ms var(--ease-apple);
      }

      .rfq-close-btn:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.15);
      }

      .rfq-form {
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      @media (max-width: 580px) {
        .form-row {
          grid-template-columns: 1fr;
        }
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .form-label {
        font-size: 0.8125rem;
        font-weight: var(--weight-semibold);
        letter-spacing: 0;
        text-transform: none;
        color: var(--color-ink);
      }

      .form-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
      }

      .form-actions .btn {
        flex: 1 1 auto;
      }

      .rfq-notice {
        font-size: 0.75rem;
        color: var(--color-graphite);
        text-align: center;
        margin-top: 0.25rem;
      }
    </style>

    <script is:inline>
      function setupRfqModal() {
        const dialog = document.getElementById('rfq-dialog-modal');
        const closeBtn = document.getElementById('rfq-dialog-close');
        const waBtn = document.getElementById('rfq-wa-direct');
        const rfqForm = document.getElementById('rfq-dialog-form');

        if (dialog && closeBtn) {
          closeBtn.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (e) => {
            const rect = dialog.getBoundingClientRect();
            if (
              e.clientX < rect.left ||
              e.clientX > rect.right ||
              e.clientY < rect.top ||
              e.clientY > rect.bottom
            ) {
              dialog.close();
            }
          });
        }

        if (waBtn) {
          waBtn.addEventListener('click', () => {
            const alloy = document.getElementById('rfq-alloy')?.value || '';
            const product = document.getElementById('rfq-product')?.value || '';
            const boq = document.getElementById('rfq-boq')?.value || '';
            const name = document.getElementById('rfq-name')?.value || '';
            const company = document.getElementById('rfq-company')?.value || '';

            const msg = `⚡ *BHANSALI METALS RFQ*\n• Alloy: ${alloy}\n• Product: ${product}\n• Specs: ${boq}\n• Contact: ${name} (${company})`;
            window.open(`https://wa.me/919892244451?text=${encodeURIComponent(msg)}`, '_blank');
          });
        }

        if (rfqForm) {
          rfqForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Thank you for your RFQ. Our sales desk will provide a formal quotation within 2 hours.');
            dialog?.close();
            rfqForm.reset();
          });
        }

        window.openRfqModal = (alloy, product) => {
          if (alloy) {
            const el = document.getElementById('rfq-alloy');
            if (el) el.value = alloy;
          }
          if (product) {
            const el = document.getElementById('rfq-product');
            if (el) el.value = product;
          }
          dialog?.showModal();
        };

        // Attach to elements with data-open-rfq
        document.querySelectorAll('[data-open-rfq]').forEach((el) => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            const alloy = el.getAttribute('data-alloy') || '';
            const product = el.getAttribute('data-product') || '';
            window.openRfqModal(alloy, product);
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupRfqModal);
      } else {
        setupRfqModal();
      }
    </script>

    <!-- Lenis Smooth Scroll (desktop only, respects reduced motion) -->
    <script>
      import Lenis from 'lenis';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

      if (!prefersReducedMotion && !isTouchDevice) {
        const lenis = new Lenis({
          lerp: 0.1,
          smoothWheel: true,
          wheelMultiplier: 1,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Pause Lenis when native dialog is open
        const observer = new MutationObserver(() => {
          const dialog = document.getElementById('rfq-dialog-modal') as HTMLDialogElement | null;
          if (dialog?.open) {
            lenis.stop();
          } else {
            lenis.start();
          }
        });

        const dialog = document.getElementById('rfq-dialog-modal');
        if (dialog) {
          observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
        }
      }
    </script>

    <!-- Scroll-triggered Reveal Animations -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // Make everything visible immediately
          document.querySelectorAll('[data-animate]').forEach(function(el) {
            el.classList.add('is-visible');
          });
          return;
        }

        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -50px 0px'
        });

        document.querySelectorAll('[data-animate]').forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
